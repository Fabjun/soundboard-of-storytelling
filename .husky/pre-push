#!/bin/sh
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/v3" || exit 1

printf '\n🔢 Pre-push: version bump check...\n'
LOCAL_VERSION=$(grep "APP_VERSION = " src/lib/changelog.ts | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" || true)
REMOTE_VERSION=$(git show origin/main:v3/src/lib/changelog.ts 2>/dev/null | grep "APP_VERSION = " | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" || true)
if [ -n "$REMOTE_VERSION" ] && [ "$LOCAL_VERSION" = "$REMOTE_VERSION" ]; then
  printf '\n❌ APP_VERSION not bumped — push aborted.\n'
  printf '   Local: %s  Remote: %s (unchanged)\n' "$LOCAL_VERSION" "$REMOTE_VERSION"
  printf '   Update v3/src/lib/changelog.ts, commit again, then push.\n'
  printf '   Deliberate bypass (ADR-0053 rules): git push --no-verify\n\n'
  exit 1
fi
printf '✅ Version OK (%s → %s).\n\n' "${REMOTE_VERSION:-new}" "$LOCAL_VERSION"

# Install path check (T13, 2026-09-30): local checks once passed while CI's `npm ci` failed
# (prepare script). When install-relevant files change, run exactly the CI install path in a
# fresh worktree of the commit being pushed.
if git diff --name-only origin/main...HEAD 2>/dev/null | grep -qE '^(v3/package(-lock)?\.json|\.husky/|\.nvmrc|v3/scripts/vale-install\.ts)'; then
  printf '📥 Pre-push: install files changed — npm ci in a fresh worktree (CI path)...\n'
  WT="$(mktemp -d)/wt"
  git worktree add -q --detach "$WT" HEAD
  # Own fresh npm cache: independent of the local ~/.npm state, like a CI runner.
  (cd "$WT/v3" && npm ci --cache "$WT.npm-cache" > "$WT.log" 2>&1)
  RC=$?
  git worktree remove --force "$WT"
  rm -rf "$WT.npm-cache"
  if [ $RC -ne 0 ]; then
    printf '\n❌ npm ci failed in a fresh worktree — push aborted. Log: %s\n' "$WT.log"
    printf '   This is the path CI takes; fix the install scripts first.\n\n'
    exit 1
  fi
  printf '✅ Fresh install OK.\n\n'
fi

printf '🛡  Pre-push: security audit (high/critical blocks)...\n'
npm audit --audit-level=high || {
  printf '\n❌ npm audit: high/critical vulnerability — push aborted.\n'
  printf '   Details above. Try `npm audit fix` (without --force) first;\n'
  printf '   review major upgrades one at a time (BACKLOG "Major dependency updates").\n'
  printf '   Deliberate bypass (ADR-0053 rules): git push --no-verify\n\n'
  exit 1
}
printf '✅ No high/critical vulnerabilities.\n\n'

printf '📦 Pre-push: bundle size check...\n'
npm run size || {
  printf '\n❌ Bundle size check FAILED — push aborted.\n'
  printf '   Bundle limit exceeded. Check the diff: what was added?\n'
  printf '   Deliberate bypass (ADR-0053 rules): git push --no-verify\n\n'
  exit 1
}
printf '✅ Bundle size OK.\n\n'

printf '🎭 Pre-push: full E2E suite (all dev-server projects) for CI parity...\n'
printf '   Estimated: ~2-3 min. Bypass with: git push --no-verify\n\n'

npm run test:e2e:all || {
  printf '\n❌ Full E2E suite FAILED — push aborted.\n'
  printf '   Playwright-Report: v3/playwright-report/index.html\n'
  printf '   Browsers missing? cd v3 && npx playwright install chromium webkit\n'
  printf '   Deliberate bypass (ADR-0053 rules): git push --no-verify\n\n'
  exit 1
}

printf '✅ Full E2E suite PASSED.\n\n'

printf '🏗  Pre-push: E2E against the production build (smoke + full + PWA)...\n'
npm run test:e2e:prod || {
  printf '\n❌ Production-build E2E FAILED — push aborted.\n'
  printf '   Read the output / report (v3/playwright-report/) first, then re-run.\n'
  printf '   Deliberate bypass (ADR-0053 rules): git push --no-verify\n\n'
  exit 1
}
printf '✅ Production-build E2E PASSED.\n\n'

# Visual regression — macOS only (baselines are macOS font rendering; CI/Ubuntu excluded)
if [ "$(uname)" = "Darwin" ]; then
  printf '🖼  Pre-push: visual regression (macOS)...\n'
  npm run test:e2e:visual || {
    printf '\n❌ Visual regression FAILED — push aborted.\n'
    printf '   Check the diffs: v3/test-results/**/*-diff.png\n'
    printf '   Intended change? npm run test:e2e:update-snapshots, review the diffs, commit.\n'
    printf '   Deliberate bypass (ADR-0053 rules): git push --no-verify\n\n'
    exit 1
  }
  printf '✅ Visual regression PASSED.\n\n'
fi

printf '✅ Pre-push checks PASSED — push allowed.\n\n'
