#!/bin/sh
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/v3" || exit 1

echo "📚 Pre-commit: syncing auto-generated docs..."
npm run sync:docs || {
  printf '\n❌ sync:docs failed — commit aborted.\n'
  printf '   Fix the generator error above, then run git commit again.\n\n'
  exit 1
}
git -C "$ROOT" add docs/architecture/README.md docs/design/design-system.md docs/development/testing.md docs/development/exceptions.md CHANGELOG.md
echo "✅ Docs synced and staged."

echo "🔨 Pre-commit: running build check in v3/..."
npm run build || {
  printf '\n❌ Build failed (type check or vite build) — commit aborted.\n'
  printf '   Fix the errors above, then run git commit again.\n\n'
  exit 1
}
echo "✅ Build passed."

echo "🎨 Pre-commit: running lint-staged (format + lint on staged files)..."
npx lint-staged || {
  printf '\n❌ lint-staged failed — commit aborted.\n'
  printf '   Fix the errors above, stage the files again, then git commit.\n\n'
  exit 1
}
echo "✅ lint-staged passed."

echo "🧪 Pre-commit: running unit tests in v3/..."
npm run test || {
  printf '\n❌ Unit tests failed — commit aborted.\n'
  printf '   Read the failure first, fix it, then run git commit again.\n\n'
  exit 1
}
echo "✅ Unit tests passed."

echo "🎭 Pre-commit: running smoke E2E tests..."
npm run test:e2e:smoke || {
  printf '\n❌ Smoke E2E tests failed — commit aborted.\n'
  printf '   Details: the output above and v3/playwright-report/ — read them before re-running.\n'
  printf '   Fix it, then run git commit again.\n\n'
  exit 1
}
echo "✅ Smoke E2E passed."

echo "🔗 Pre-commit: checking markdown link integrity..."
npm run link:check || {
  printf '\n❌ Link check failed — commit aborted.\n'
  printf '   Fix the dead internal links above, then run git commit again.\n\n'
  exit 1
}
echo "✅ Link check passed — Commit wird fortgesetzt."

# ── Non-blocking BACKLOG drift reminder ──────────────────────────────────────
BACKLOG_STAGED=$(git -C "$ROOT" diff --cached --name-only 2>/dev/null | grep "^docs/backlog.md$" || true)
LAST_BACKLOG=$(git -C "$ROOT" log -1 --format="%H" -- docs/backlog.md 2>/dev/null || true)
if [ -z "$BACKLOG_STAGED" ] && [ -n "$LAST_BACKLOG" ]; then
  COMMITS_SINCE=$(git -C "$ROOT" rev-list --count "$LAST_BACKLOG"..HEAD 2>/dev/null || echo "0")
  BACKLOG_THRESHOLD=10
  if [ "$COMMITS_SINCE" -ge "$BACKLOG_THRESHOLD" ]; then
    printf '\n💡 BACKLOG reminder: docs/backlog.md was last updated %s commits ago.\n' "$COMMITS_SINCE"
    printf '   Consider whether recent work added deferred items or closed existing ones.\n'
    printf '   (Reminder only — commit proceeds.)\n\n'
  fi
fi
