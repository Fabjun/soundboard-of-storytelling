{
  "name": "soundboard-of-storytelling",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "npm run vale:install && cd .. && husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=smoke --project=smoke-webkit --project=full",
    "test:e2e:smoke": "playwright test --project=smoke --project=smoke-webkit",
    "test:e2e:full": "playwright test --project=full --project=full-webkit",
    "test:e2e:mobile": "playwright test --project=mobile --project=mobile-chromium",
    "test:e2e:all": "playwright test --project=smoke --project=smoke-webkit --project=full --project=full-webkit --project=mobile --project=mobile-chromium",
    "test:e2e:prod": "npm run build && E2E_TARGET=prod playwright test --project=smoke --project=full --project=pwa",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:update-snapshots": "playwright test --project=visual --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:mutation": "stryker run",
    "mutation:report": "tsx scripts/mutation-report.ts",
    "mutation:modules": "tsx scripts/mutation-modules.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "format:md": "tsx scripts/format-md.ts",
    "size": "size-limit",
    "sync:adr": "tsx scripts/sync-adr.ts",
    "sync:classes": "tsx scripts/sync-classes.ts",
    "sync:tokens": "tsx scripts/sync-tokens.ts",
    "sync:tests": "tsx scripts/sync-tests.ts",
    "sync:changelog": "tsx scripts/sync-changelog.ts",
    "sync:exceptions": "tsx scripts/sync-exceptions.ts",
    "sync:steps": "tsx scripts/sync-steps.ts",
    "vale:install": "tsx scripts/vale-install.ts",
    "typecheck": "tsc -b",
    "sync:docs": "npm run sync:adr && npm run sync:classes && npm run sync:tokens && npm run sync:tests && npm run sync:changelog && npm run sync:steps && npm run sync:exceptions",
    "link:check": "remark --no-stdout --quiet --frail --use remark-validate-links ..",
    "lint:docs": "cd .. && vale README.md CLAUDE.md docs",
    "audit:inline-styles": "tsx scripts/audit-inline-styles.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@preact/signals": "^2.11.3",
    "idb": "^8.0.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/file": "^14.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "github-slugger": "^2.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.9.9",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "size-limit": "^14.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "//overrides": {
    "typed-rest-client > qs": "typed-rest-client 2.3 (pinned by @stryker-mutator/core 10) pins qs 6.15.1 with moderate advisories (GHSA-q8mj-m7cp-5q26, GHSA-x5fp-wj9c-mxmx, GHSA-4mjr-xmp4-gh2g); 6.16.0 fixes them within the same major — remove when Stryker ships typed-rest-client >= 3.1.2",
    "unified-args > chokidar": "unified-args 11 (via remark-cli, the docs link checker) asks for chokidar 3, which pulls in braces <= 3.0.3 with a high advisory (GHSA-vfj7-8cjw-p6xm) that has no fixed version; chokidar 4 needs no braces and keeps the watch API unified-args uses — remove when remark-cli ships unified-args with chokidar >= 4"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.16.0"
    },
    "unified-args": {
      "chokidar": "^4.0.3"
    }
  }
}
