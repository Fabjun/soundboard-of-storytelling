{
  "name": "soundboard-of-storytelling",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "npm run vale:install && cd .. && husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=smoke --project=smoke-webkit --project=full",
    "test:e2e:smoke": "playwright test --project=smoke --project=smoke-webkit",
    "test:e2e:full": "playwright test --project=full --project=full-webkit",
    "test:e2e:mobile": "playwright test --project=mobile --project=mobile-chromium",
    "test:e2e:all": "playwright test --project=smoke --project=smoke-webkit --project=full --project=full-webkit --project=mobile --project=mobile-chromium",
    "test:e2e:prod": "npm run build && E2E_TARGET=prod playwright test --project=smoke --project=full --project=pwa",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:update-snapshots": "playwright test --project=visual --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "format:md": "tsx scripts/format-md.ts",
    "size": "size-limit",
    "sync:adr": "tsx scripts/sync-adr.ts",
    "sync:classes": "tsx scripts/sync-classes.ts",
    "sync:tokens": "tsx scripts/sync-tokens.ts",
    "sync:tests": "tsx scripts/sync-tests.ts",
    "sync:changelog": "tsx scripts/sync-changelog.ts",
    "sync:exceptions": "tsx scripts/sync-exceptions.ts",
    "sync:steps": "tsx scripts/sync-steps.ts",
    "vale:install": "tsx scripts/vale-install.ts",
    "typecheck": "tsc -b",
    "sync:docs": "npm run sync:adr && npm run sync:classes && npm run sync:tokens && npm run sync:tests && npm run sync:changelog && npm run sync:steps && npm run sync:exceptions",
    "link:check": "remark --no-stdout --quiet --frail --use remark-validate-links ..",
    "lint:docs": "cd .. && vale README.md CLAUDE.md docs",
    "audit:inline-styles": "tsx scripts/audit-inline-styles.ts"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@noble/hashes": "^2.2.0",
    "@preact/signals": "^2.9.1",
    "idb": "^8.0.3",
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@playwright/test": "^1.60.0",
    "@preact/preset-vite": "^2.10.5",
    "@size-limit/file": "^12.1.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.12.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "github-slugger": "^2.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.8.3",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "size-limit": "^12.1.0",
    "tsx": "^4.19.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
